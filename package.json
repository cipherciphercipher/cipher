{
    "name": "vencord-cipher",
    "private": true,
    "version": "0.1.0",
    "description": "End-to-end encrypted messaging for Discord (Vencord userplugin) using age or OpenPGP",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "packageManager": "pnpm@10.22.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint .",
        "vencord:check": "node scripts/vencord-check.mjs",
        "check": "pnpm lint && pnpm typecheck && pnpm test"
    },
    "dependencies": {
        "age-encryption": "0.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@noble/ciphers": "2.4.0",
        "@noble/curves": "2.4.0",
        "@noble/hashes": "2.4.0",
        "@types/node": "^22.10.0",
        "eslint": "^10.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.50.0",
        "vitest": "^4.0.0"
    }
}
