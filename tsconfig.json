{
    // Standalone typecheck for the framework-free core and the tests.
    // The Vencord UI (src/index.tsx, src/ui) is typechecked inside a Vencord
    // checkout by `pnpm vencord:check` / CI, because it needs Vencord's types.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src/core/**/*", "server/src/**/*", "test/**/*", "scripts/*.d.mts", "vitest.config.ts"]
}
